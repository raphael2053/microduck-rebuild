{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__linear.*",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/hooks/linear-guard.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/hooks/no-direct-main.py"
          }
        ]
      }
    ]
  }
}
